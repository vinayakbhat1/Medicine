# dev = OTP code is returned in the API response (never use in production)
ENV=dev
DATABASE_URL=sqlite:///./medtime.db
# production example: postgresql+psycopg2://medtime:medtime@localhost:5432/medtime
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=720
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MISSED_GRACE_MINUTES=120
LATE_AFTER_MINUTES=30
DOSE_HORIZON_DAYS=14
AUTO_DECREMENT_STOCK=false
RUN_SCHEDULER=true
OTP_MAX_PER_15_MIN=5
