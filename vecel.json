{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "medtime": {
      "root": "medtime",
      "framework": "vite"
    },
    "medtime-backend": {
      "root": "backend/medtime-backend/medtime-backend",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "medtime"
      }
    }
  ]
}
